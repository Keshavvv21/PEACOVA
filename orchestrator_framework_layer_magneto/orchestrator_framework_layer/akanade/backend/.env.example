# ── Copy to .env and fill in. Keys are stored here / SSM, never committed (§14).
JWT_SECRET=change-me-in-prod

# Framework adapter (§2.2): native | langgraph | adk | claude
CHAT_AGENT_FRAMEWORK=langgraph

# ── Model tiers (§3) — all OpenAI-compatible. Leave a base URL empty to
#    skip that rung; with everything empty the deterministic rule-based
#    floor answers (fully offline mode). NOTE: don't put a trailing
#    "# comment" on an otherwise-empty VALUE=  line — python-dotenv treats
#    it as literal value text, not a comment, when there's nothing before
#    the "#" (confirmed: `dotenv_values()` on a KEY=   # comment line with
#    an empty value returns the comment text itself, truthy and wrong).
#    Comments describing an empty default go on their own line instead.
# e.g. https://api.openai.com/v1
LUNA_BASE_URL=
LUNA_API_KEY=
LUNA_MODEL=gpt-5.6-luna

MAX_BASE_URL=
MAX_API_KEY=
MAX_MODEL=gpt-5.6-max

# platform.deepseek.com — pay-as-you-go, NOT a free tier (cheap, but a
# real card + credits are required; a 402 Payment Required means this)
# e.g. https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
# deepseek-v4-flash (this design's original default) isn't DeepSeek's real
# current model id — deepseek-chat is (verify at api-docs.deepseek.com)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SHADOW=1         # §3.4: shadow mode until promoted

GROQ_BASE_URL=https://api.groq.com/openai/v1
# free tier, no card required — console.groq.com/keys
GROQ_API_KEY=
# verified against a real tool-calling request (see HOW_IT_WAS_BUILT.md);
# Groq's free-tier lineup changes over time — re-check /v1/models if this 404s
GROQ_MODEL=openai/gpt-oss-120b

# The local Algo Engine tier (§19), in rotation in CHAINS' delay_ok/bulk
# tiers: point at a running `algo-engine serve`, e.g. http://localhost:8080/v1
# GPU acceleration is a build-time choice on that server (`make cuda` under
# performance_optimizer/algo_optimzer_engine/algo-engine-source, needs an
# NVIDIA GPU + nvcc) — this URL is the same either way.
ALGO_ENGINE_BASE_URL=

# The REAL Algo-Kaizen app's own REST API — NOT the model tier above (that's
# an LLM endpoint, this is real PM data). Set this to have chat auth and
# read tools (list_projects, query_tasks) use the real app's actual data
# and the real signed-in user's identity instead of the Compass OS demo
# store. Writes are NOT yet converted (still hit demo data either way).
# e.g. http://localhost:8000
REAL_APP_API_BASE_URL=

# ── Extensible providers (llm/README.md) ────────────────────────────────
# Add ANY OpenAI-compatible API as a new tier rung with zero code changes —
# a JSON array of {name, base_url, api_key, model, tiers, requires_key}.
# "tiers" picks which chain(s) it joins (default: all three), inserted
# before rule-based. "requires_key" (default true) — set false only for a
# self-hosted, unauthenticated endpoint (like  below); with it true
# (the default) a blank api_key makes this rung unavailable rather than
# firing a doomed unauthenticated request every turn.
# Example: OpenRouter as an extra realtime rung:
# EXTRA_LLM_PROVIDERS=[{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"sk-or-...","model":"openrouter/auto","tiers":["realtime"]}]
# "openrouter/auto" is OpenRouter's OWN meta-router — it picks a different
# underlying model per request on their end. Real (tiny) per-token cost on
# your OpenRouter account, not a free tier like Groq/Gemini above.
# Gemini Flash (free tier, aistudio.google.com/apikey — gemini-3.6-flash is
# the current model as of this writing, verified to support tool-calling):
# EXTRA_LLM_PROVIDERS=[{"name":"gemini-flash","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"AIza...","model":"gemini-3.6-flash","tiers":["realtime","bulk"]}]
EXTRA_LLM_PROVIDERS=[]

# A local small language model via Ollama (LangChain's ChatOllama) — real
# offline inference, no API key. Needs `pip install langchain-ollama` and
# `ollama serve` running with OLLAMA_MODEL pulled.
# e.g. http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:1b

# The real Anthropic Claude API (llm/providers.py's AnthropicNative) — the
# "claude" agent framework's own provider (needs `pip install anthropic`).
# Unset means that framework option falls back through the normal chain,
# same as any other unconfigured rung.
# console.anthropic.com/settings/keys
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ── MCP (Model Context Protocol) client (agent/mcp_client.py) ───────────
# A JSON array of {name, command, args, env} (stdio) or {name, url}
# (remote HTTP/SSE) — one per external MCP server to pull tools from,
# merged into the shared tool set every framework uses. Needs
# `pip install mcp`. Defaults to one bundled, offline, zero-side-effect
# example server (mcp_servers/utility_server.py) so this integration
# works out of the box; point at a real external MCP server instead:
# MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/some/dir"]}]
MCP_SERVERS=[{"name": "utility", "command": "python", "args": ["-m", "app.mcp_servers.utility_server"]}]

# ── OAuth connections (app/oauth/, app/oauth_store.py) ───────────────────
# Real per-USER "Connect your account" OAuth 2.0 for GitHub/Linear/Google
# — genuinely different from MCP_SERVERS' static headers above: each
# person authorizes their OWN account via a real browser consent screen,
# giving the assistant write-capable tools (open an issue, create a
# ticket, send a calendar invite) scoped to THEM, not one shared token.
# Register a real OAuth app on each provider's own developer console and
# set its client id/secret here — a provider left blank is just
# unavailable, same as any other unconfigured rung.
#   GitHub:  github.com/settings/developers → New OAuth App
#   Linear:  your workspace → Settings → API → OAuth applications
#   Google:  console.cloud.google.com → Credentials → OAuth client ID
# Each app's callback/redirect URI must be exactly
# {OAUTH_REDIRECT_BASE_URL}/api/oauth/{github|linear|google}/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# This service's own public URL (protocol+host+port) — used to build the
# redirect_uri sent to each provider. Must match what's registered above.
OAUTH_REDIRECT_BASE_URL=http://localhost:8001
# The PM frontend's URL — where /api/oauth/{provider}/callback sends the
# browser back to once a connection is saved.
FRONTEND_BASE_URL=http://localhost:5173
# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# encrypting stored OAuth tokens at rest. Unset falls back to a fixed,
# non-secret dev key (app/crypto.py) — fine for a laptop/CI run with no
# real OAuth connections at stake; a real deploy MUST set this.
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Storage: local (JSON files) | dynamodb ──────────────────────────────
STORAGE_BACKEND=local
DATA_DIR=./data
# For dynamodb: endpoint empty = real AWS; set for dynamodb-local
# e.g. http://dynamodb:8000
DYNAMO_ENDPOINT=
AWS_REGION=ap-south-1

# ── Retrieval ───────────────────────────────────────────────────────────
GRAPH_TTL_SECONDS=60
CHROMA_DIR=./chroma_db
EMBEDDER=auto             # auto | minilm | hash
